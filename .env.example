# Public URLs
PUBLIC_SITE_URL=https://example.com
API_BASE_URL=https://example.com/api/v1
MAP_TILES_URL=https://tiles.example.com/{z}/{x}/{y}.png

# Server
DATABASE_URL=postgresql://madhi:change-me@localhost:5432/madhi_tracker
JWT_SECRET=replace-with-production-secret
DEVICE_TOKEN_HASH_SECRET=replace-with-production-secret

# Android build configuration
ANDROID_API_BASE_URL=https://example.com/api/v1
ANDROID_SIGNING_STORE_FILE=/absolute/path/to/release.keystore
ANDROID_SIGNING_STORE_PASSWORD=replace-with-local-secret
ANDROID_SIGNING_KEY_ALIAS=release
ANDROID_SIGNING_KEY_PASSWORD=replace-with-local-secret

# Backups and alerts
BACKUP_ENCRYPTION_KEY=replace-with-production-secret
ALERT_WEBHOOK_URL=https://example.com/webhook
