APP_ENV=development

POSTGRES_DB=madhi_tracker
POSTGRES_USER=madhi
POSTGRES_PASSWORD=madhi_dev_password
DATABASE_URL=postgresql://madhi:madhi_dev_password@postgres:5432/madhi_tracker

DEVICE_TOKEN_HASH_SECRET=dev-secret-change-me
ACTIVATION_CODE_HASH_SECRET=dev-secret-change-me
INITIAL_TRIP_ID=8f14e45f-ceea-467a-9f4e-2b1c9a1a1a1a
INITIAL_TRIP_NAME=Madhi 2026
INITIAL_ACTIVATION_CODE=XXXX-XXXX
ACTIVATION_CODE_TTL_MINUTES=60

MAX_BATCH_POINTS=200
MAX_REQUEST_BYTES=1048576
RATE_LIMIT_PER_MINUTE=120

# Obligatoire en production pour proteger les endpoints consommes par le site.
# Une seule valeur pour l'API et pour le conteneur du site : c'est le conteneur
# qui pose l'en-tete Authorization, le navigateur ne la voit jamais.
PUBLIC_READ_TOKEN=dev-read-token-change-me

# Segment secret de l'URL familiale : https://<domaine>/f/<SEGMENT>/
# Le fabriquer avec `openssl rand -hex 16`. Le changer revoque l'ancien lien.
SITE_SECRET_SEGMENT=segment-de-developpement
# Adresse d'ecoute du conteneur du site, relaye par le nginx de l'hote.
SITE_BIND=127.0.0.1:8112
# Adresse des points de la carte, dans l'application.
#
# Eteint par defaut, et c'est voulu : allumer cette option fait sortir des
# coordonnees du VPS vers Nominatim. Le telephone, lui, ne parle jamais qu'au
# serveur du voyage — c'est tout l'interet de passer par ici. Nominatim ne
# voit donc qu'une adresse IP, celle du VPS, et jamais celle du reseau mobile
# traverse.
#
# L'identite est obligatoire des que l'option est allumee : Nominatim exige un
# User-Agent nominatif et joignable, et refuse le trafic anonyme.
REVERSE_GEOCODE_ENABLED=false
REVERSE_GEOCODE_URL=https://nominatim.openstreetmap.org/reverse
REVERSE_GEOCODE_USER_AGENT=Madhi Tracker (contact@exemple.fr)

LOG_LEVEL=INFO
