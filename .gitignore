# Environment files with real values
.env
.env.*
!.env.example

# Android signing material
*.jks
*.keystore
keystore.properties
local.properties

# Mots de passe du site familial (auth_basic)
*.htpasswd

# Secrets and certificates
*.key
*.pem
*.p12
*.crt
id_rsa*
id_ed25519*

# Database dumps and backups
*.dump
*_dump.sql
*.backup.sql
*.sqlite
*.sqlite3
backups/
dumps/

# Private build artifacts
*.apk
*.aab

# Dependency and build output
node_modules/
dist/
build/
.gradle/
.android-sdk/
.cache/
__pycache__/
.venv/
*.log

# Exports .docx generes depuis les .md, qui sont la source de verite
# (arch/README_architecture.md). Les versionner ferait diverger deux copies
# du meme document sans qu'on puisse relire la difference.
arch/*.docx

# Donnees Natural Earth mondiales, telechargees par tools/tiles/fetch_and_clip.py.
# 137 Mo dont l'essentiel decrit des continents que ce voyage ne traverse pas.
# Seul le decoupage au corridor est versionne, dans tools/tiles/data/.
tools/tiles/monde/
