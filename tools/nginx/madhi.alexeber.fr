# Site familial — configuration d'amorcage du nginx de l'hote, en HTTP seul.
#
# Ce fichier ne fait plus que relayer : tout ce qui concerne le site — chemin
# secret, mot de passe, token de lecture, en-tetes de confidentialite — vit
# desormais dans le conteneur `site` de server/docker-compose.yml, via
# tools/nginx/site.conf.template. Ne rien ajouter ici qui appartienne au site :
# ce serait de l'etat hors de la stack, invisible depuis le depot.
#
# Pourquoi ce vhost existe malgre tout : un seul processus peut ecouter le port
# 443, et c'est le nginx de l'hote qui le tient deja pour l'API. Il termine donc
# TLS pour les deux domaines et relaie ici en clair, sur la boucle locale.
#
# Comme pour madhi-server.alexeber.fr, ce fichier ne sert qu'a obtenir le
# premier certificat : `certbot --nginx` le reecrit ensuite sur le VPS pour
# ajouter l'ecoute en 443 et la redirection 80 -> 443. Ne jamais le recopier
# par-dessus le fichier deploye, cela supprimerait HTTPS.

server {
    listen 80;
    listen [::]:80;
    server_name madhi.alexeber.fr;

    # Ce domaine n'a pas a annoncer sa version de nginx.
    server_tokens off;

    # Pas de Strict-Transport-Security, volontairement. HSTS transformerait un
    # certificat expire en blocage total cote famille, la ou l'avertissement du
    # navigateur reste contournable. Or l'expiration en plein voyage est un
    # risque identifie du projet (SERVER_DEPLOYMENT.md). A ajouter le jour ou le
    # renouvellement automatique aura fait ses preuves sur une annee.

    location / {
        # Sans URI apres le port : l'adresse demandee, segment secret compris,
        # arrive au conteneur telle quelle.
        proxy_pass http://127.0.0.1:8112;
        proxy_http_version 1.1;

        proxy_set_header Host $host;

        # Le conteneur transmet cette valeur a l'API, seul en-tete sur lequel
        # compte son rate limiting. La perdre ici mettrait toute la famille
        # dans le meme compartiment.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Le mot de passe familial est demande par le conteneur : l'en-tete
        # Authorization du navigateur doit lui parvenir, et son 401 revenir.
        proxy_pass_request_headers on;
    }
}
