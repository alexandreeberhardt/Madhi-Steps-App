# Configuration d'amorcage, en HTTP seul.
#
# Elle sert uniquement a obtenir le premier certificat : une fois
# `certbot --nginx` passe, c'est certbot qui reecrit ce fichier sur le VPS pour
# y ajouter l'ecoute en 443, le certificat et la redirection 80 -> 443. Le
# fichier deploye ne ressemble donc plus a celui-ci.
#
# Ne jamais recopier ce fichier par-dessus le fichier deploye : cela supprimerait
# HTTPS, alors que le contrat API impose HTTPS et que l'application refuse le
# trafic en clair. Voir SERVER_DEPLOYMENT.md, section Nginx.

server {
    listen 80;
    listen [::]:80;
    server_name madhi-server.alexeber.fr;

    location / {
        proxy_pass http://127.0.0.1:8111;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
